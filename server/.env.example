PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/xtovia_bulkorder

# Password your team uses to sign in to the admin panel
ADMIN_PASSWORD=change-me

# Long random string used to sign admin login tokens
JWT_SECRET=change-me-to-a-long-random-string

# Optional. Only set this when the frontend is hosted on a different domain
# from the API, e.g. https://bulk.xtovia.com (several URLs: separate with commas)
FRONTEND_URL=
